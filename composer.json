{
    "name": "tienda/sistema-ventas",
    "description": "Sistema de gestión de ventas migrado a MVC y ORM Eloquent",
    "type": "project",
    "require": {
        "php": "^8.1",
        "illuminate/database": "^10.0",
        "vlucas/phpdotenv": "^5.5",
        "symfony/var-dumper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Models\\": "models/",
            "App\\Controllers\\": "controllers/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
